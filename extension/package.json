{
  "name": "codigo-bridge",
  "displayName": "Codigo Bridge",
  "publisher": "btwiuse",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onTerminalProfile:extension.terminal-profile",
    "onFileSystem:hostfs"
  ],
  "browser": "./dist/web/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.createNewTerminal",
        "title": "Create New Terminal",
        "category": "Codigo",
        "icon": {
          "light": "./resources/icons/new-terminal-light.svg",
          "dark": "./resources/icons/new-terminal-dark.svg"
        }
      },
      {
        "command": "extension.createNewTerminal2",
        "title": "Create New Terminal2",
        "category": "Codigo"
      },
      {
        "command": "extension.createNewTerminal3",
        "title": "Create New Terminal3",
        "category": "Codigo"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "isWeb || !isWeb",
          "group": "navigation",
          "command": "extension.createNewTerminal"
        }
      ]
    },
    "terminal": {
      "profiles": [
        {
          "id": "extension.terminal-profile",
          "title": "Extension Terminal Profile"
        }
      ]
    }
  },
  "scripts": {
    "compile-web": "npm run check-types && node esbuild.js",
    "watch-web": "node esbuild.js --watch",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@polkadot/extension-inject": "^0.58.4",
    "@polkadot/types-augment": "^15.7.1",
    "@types/vscode": "^1.90.0",
    "@vscode/test-web": "^0.0.54",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
